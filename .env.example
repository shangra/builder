# Скопируйте в .env и заполните.
# Затем: npm run env

NODE_ENV=development

# PostgreSQL — общее для pivot и миграций
DB_HOST=localhost
DB_PORT=5433
DB_USER=
DB_PASS=
DB_DATABASE=
DB_SCHEMA=pivot7
DB_TEST_DATABASE=
DB_DIALECT=postgres
DB_POOL={"max":300,"min":0,"idle":1000}

# Порты и хосты сервисов (должны совпадать с box.config.json)
PIVOT_PORT=3391
ADMIN_PORT=3372
MF_TYPES_PORT=33702
SPREADSHEET_PORT=3380
ESB_HOST=localhost:3310
ANALYTIC_HOST=https://localhost:3195

SESSION_SECRET=qwerty
CONNECTOR_SALT=123

# Пока всегда пишется пустым в .env пивота
LICENSE_KEY=

SERVER_KEY=/atm/ssl/atm.key
SERVER_CERT=/atm/ssl/atm.cer
SERVER_CA=/atm/ssl/atm_chain.cer
CLIENT_CA=/atm/ssl/atm_chain.cer
